// ============================================================
// 🔄 REFRESH FUNCTIONS - FIXED
// ============================================================

function refreshAll() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    
    // Update all formulas in Academic Data
    var dataSheet = ss.getSheetByName('📊 Academic Data');
    if (dataSheet) {
      var lastRow = dataSheet.getLastRow();
      if (lastRow > 1) {
        var formulas = [
          {col:6, formula:'=IF(E2="A",4,IF(E2="A-",3.67,IF(E2="B+",3.33,IF(E2="B",3,IF(E2="B-",2.67,IF(E2="C+",2.33,IF(E2="C",2,IF(E2="C-",1.67,IF(E2="D+",1.33,IF(E2="D",1,IF(E2="F",0,IF(E2="W",0,""))))))))))))'},
          {col:10, formula:'=IF(OR(E2="D+",E2="D",E2="C-",E2="C",E2="C+",E2="B-",E2="B",E2="B+"),"Yes",IF(E2="","",IF(OR(E2="A",E2="A-",E2="F",E2="W"),"No","")))'},
          {col:11, formula:'=IF(OR(E2="D+",E2="D"),1,IF(OR(E2="C",E2="C-"),2,IF(E2="C+",3,IF(E2="B-",4,IF(E2="B",5,IF(E2="B+",6,IF(OR(E2="A-",E2="A"),7,IF(OR(E2="F",E2="W"),8,""))))))))'},
          {col:14, formula:'=IF(AND(G2<>"Completed",E2<>"W",E2<>"F",E2<>""),D2,0)'},
          {col:16, formula:'=IF(ROW(B2)=MAX(FILTER(ROW(B:B),B:B=B2)),"Yes","No")'},
          {col:17, formula:'=IFERROR(SUMPRODUCT((A:A=A2)*(D:D)*(F:F)*(F:F>0))/SUMPRODUCT((A:A=A2)*(D:D)*(F:F>0)),0)'},
          {col:18, formula:'=IFERROR(SUMPRODUCT((H:H="Completed")*(D:D)*(F:F)*(F:F>0))/SUMPRODUCT((H:H="Completed")*(D:D)*(F:F>0)),0)'}
        ];
        
        formulas.forEach(function(f) {
          try {
            dataSheet.getRange(2, f.col, lastRow - 1, 1).setFormula(f.formula);
          } catch(e) {
            // Skip if error
          }
        });
      }
    }
    
    // Refresh Dashboard
    var dashSheet = ss.getSheetByName('📈 Dashboard');
    if (dashSheet) {
      try {
        var statsRange = dashSheet.getRange(6, 1, 20, 7);
        statsRange.clearContent();
        
        var formulas2 = [
          {row:6, col:1, value:'📊 Current CGPA'},
          {row:6, col:2, value:'=IFERROR(SUMPRODUCT(\'📊 Academic Data\'!D:D,\'📊 Academic Data\'!F:F,\'📊 Academic Data\'!F:F>0,\'📊 Academic Data\'!H:H="Completed")/SUMPRODUCT(\'📊 Academic Data\'!D:D,\'📊 Academic Data\'!F:F>0,\'📊 Academic Data\'!H:H="Completed"),0)'},
          {row:7, col:1, value:'✅ Credits Earned'},
          {row:7, col:2, value:'=SUMPRODUCT(\'📊 Academic Data\'!D:D,\'📊 Academic Data\'!F:F>0,\'📊 Academic Data\'!H:H="Completed")'},
          {row:8, col:1, value:'📚 Credits Remaining'},
          {row:8, col:2, value:'=Settings!B3 - B7'},
          {row:9, col:1, value:'🎯 Graduation %'},
          {row:9, col:2, value:'=IFERROR(B7/Settings!B3*100,0)'}
        ];
        
        formulas2.forEach(function(f) {
          try {
            dashSheet.getRange(f.row, f.col).setValue(f.value);
          } catch(e) {
            // Skip if error
          }
        });
      } catch(e) {
        // Skip if error
      }
    }
    
    // Log activity
    logActivity('System', 'Refresh', 'All sheets refreshed automatically');
    
  } catch (error) {
    Logger.log('refreshAll Error: ' + error);
  }
}

// ============================================================
// 📋 LOG ACTIVITY - FIXED
// ============================================================

function logActivity(user, action, details) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('📋 Activity Log');
    if (!sheet) return;
    
    var timestamp = new Date();
    var lastRow = sheet.getLastRow() + 1;
    sheet.getRange(lastRow, 1).setValue(timestamp);
    sheet.getRange(lastRow, 2).setValue(user || 'System');
    sheet.getRange(lastRow, 3).setValue(action);
    sheet.getRange(lastRow, 4).setValue(details);
    sheet.getRange(lastRow, 5).setValue(sheet.getName());
    
  } catch (error) {
    Logger.log('logActivity Error: ' + error);
  }
}

// ============================================================
// 🏗️ CREATE MENU - FIXED
// ============================================================

function createMenu() {
  try {
    var ui = SpreadsheetApp.getUi();
    var menu = ui.createMenu('🎓 Academic ERP');
    menu.addItem('🔄 Refresh All', 'refreshAll');
    menu.addItem('📊 View Dashboard', 'viewDashboard');
    menu.addItem('🔄 Retake Planner', 'viewRetakePlanner');
    menu.addItem('🎯 CGPA Predictor', 'viewCGPAPredictor');
    menu.addSeparator();
    menu.addItem('📤 Export PDF Report', 'exportReport');
    menu.addItem('📋 Generate Transcript', 'generateTranscript');
    menu.addSeparator();
    menu.addItem('🏗️ Reset All Sheets', 'resetAll');
    menu.addItem('📖 Help', 'showHelp');
    menu.addToUi();
  } catch (error) {
    Logger.log('createMenu Error: ' + error);
  }
}

// ============================================================
// 📤 EXPORT FUNCTIONS - FIXED
// ============================================================

function exportReport() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var ui = SpreadsheetApp.getUi();
    
    var response = ui.alert('📤 Export Report', 
      'Choose export format:', 
      ui.ButtonSet.YES_NO_CANCEL);
    
    if (response == ui.Button.YES) {
      var dashboard = ss.getSheetByName('📈 Dashboard');
      if (dashboard) {
        var url = ss.getUrl();
        var exportUrl = url.replace(/edit.*$/, '') + 
          'export?format=pdf&size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false&pagenum=false&gridlines=false&fzr=true&gid=' + 
          dashboard.getSheetId();
        
        var html = '<html><body><script>window.open("' + exportUrl + '");google.script.host.close();</script></body></html>';
        var htmlOutput = HtmlService.createHtmlOutput(html).setWidth(1).setHeight(1);
        ui.showModalDialog(htmlOutput, 'Generating PDF...');
        logActivity('User', 'Export', 'PDF Report exported');
      }
    } else if (response == ui.Button.NO) {
      var dataSheet = ss.getSheetByName('📊 Academic Data');
      if (dataSheet) {
        var data = dataSheet.getDataRange().getValues();
        var csv = data.map(row => row.join(',')).join('\n');
        
        var html = '<html><body><a href="data:text/csv;charset=utf-8,' + 
          encodeURIComponent(csv) + '" download="Academic_Data.csv">Download CSV</a>' +
          '<script>window.onload=function(){document.querySelector("a").click();google.script.host.close();}</script></body></html>';
        
        var htmlOutput = HtmlService.createHtmlOutput(html).setWidth(300).setHeight(100);
        ui.showModalDialog(htmlOutput, 'Download CSV');
        logActivity('User', 'Export', 'CSV Report exported');
      }
    }
  } catch (error) {
    Logger.log('exportReport Error: ' + error);
    SpreadsheetApp.getUi().alert('❌ Export Error: ' + error);
  }
}

function generateTranscript() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var dataSheet = ss.getSheetByName('📊 Academic Data');
    var dashSheet = ss.getSheetByName('📈 Dashboard');
    
    if (!dataSheet || !dashSheet) return;
    
    var ui = SpreadsheetApp.getUi();
    ui.alert('📋 Transcript', 
      'CGPA: ' + dashSheet.getRange('B4').getValue() + '\n' +
      'Credits: ' + dashSheet.getRange('B5').getValue() + '\n' +
      'Courses: ' + (dataSheet.getLastRow() - 1) + '\n\n' +
      '📄 Full transcript will be generated in PDF format.',
      ui.ButtonSet.OK);
    
    logActivity('User', 'Transcript', 'Transcript generated');
  } catch (error) {
    Logger.log('generateTranscript Error: ' + error);
  }
}

