// ============================================================
// 🔄 RESET ALL - FIXED
// ============================================================

function resetAll() {
  try {
    var ui = SpreadsheetApp.getUi();
    var response = ui.alert('⚠️ Warning', 
      'This will DELETE ALL DATA and reset everything. Continue?', 
      ui.ButtonSet.YES_NO);
    
    if (response == ui.Button.YES) {
      var ss = SpreadsheetApp.getActiveSpreadsheet();
      var sheets = ss.getSheets();
      sheets.forEach(function(sheet) {
        try {
          ss.deleteSheet(sheet);
        } catch(e) {
          // Skip if can't delete
        }
      });
      createAllSheets();
      logActivity('System', 'Reset', 'All sheets recreated');
      ui.alert('✅ Reset complete! All sheets recreated.');
    }
  } catch (error) {
    Logger.log('resetAll Error: ' + error);
  }
}

function showHelp() {
  try {
    var ui = SpreadsheetApp.getUi();
    ui.alert('📖 Help Guide', 
      '🎓 ACADEMIC ERP SYSTEM v5.0\n\n' +
      '📊 Dashboard: View all stats\n' +
      '🔄 Retake Planner: Smart priority system\n' +
      '🎯 CGPA Predictor: What-if analysis\n' +
      '📅 Semester Planner: Plan your courses\n' +
      '🎓 Graduation Progress: Track completion\n' +
      '⚠️ Academic Advisor: AI style insights\n' +
      '🏆 Achievements: Track your goals\n' +
      '⚙️ Settings: Customize everything\n\n' +
      '💡 Priority System:\n' +
      '🔴 D > 🟠 C > 🟡 C+ > 🟢 B- > 🔵 B > 🟣 B+',
      ui.ButtonSet.OK);
  } catch (error) {
    Logger.log('showHelp Error: ' + error);
  }
}

// ============================================================
// 🚀 ON OPEN TRIGGER - FIXED
// ============================================================

function onOpen() {
  try {
    createMenu();
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    
    const requiredSheets = [
      "📊 Academic Data",
      "📈 Dashboard",
      "🔄 Retake Planner"
    ];
    
    const allExist = requiredSheets.every(sheetName =>
      ss.getSheetByName(sheetName)
    );
    
    if (!allExist) {
      createAllSheets();
      return;
    }
    
    refreshAll();
    
  } catch (error) {
    Logger.log("onOpen Error: " + error);
  }
}

// ============================================================
// 📊 ON EDIT TRIGGER - FIXED
// ============================================================

function onEdit(e) {
  try {
    var range = e.range;
    var sheet = range.getSheet();
    var row = range.getRow();
    var col = range.getColumn();
    
    if (!sheet || row < 2) return;
    
    // If editing Academic Data
    if (sheet.getName() === '📊 Academic Data') {
      var dataSheet = sheet;
      
      // Grade Changed
      if (col === 5) {
        var lastRow = dataSheet.getLastRow();
        var courseCode = dataSheet.getRange(row, 2).getValue();
        var semester = dataSheet.getRange(row, 1).getValue();
        
        // Update Formulas
        var formulas = [
          {
            col: 6,
            formula: `=IF(E${row}="A",4,IF(E${row}="A-",3.67,IF(E${row}="B+",3.33,IF(E${row}="B",3,IF(E${row}="B-",2.67,IF(E${row}="C+",2.33,IF(E${row}="C",2,IF(E${row}="C-",1.67,IF(E${row}="D+",1.33,IF(E${row}="D",1,IF(E${row}="F",0,IF(E${row}="W",0,""))))))))))))`
          },
          {
            col: 10,
            formula: `=IF(OR(E${row}="D+",E${row}="D",E${row}="C-",E${row}="C",E${row}="C+",E${row}="B-",E${row}="B",E${row}="B+"),"Yes",IF(E${row}="","",IF(OR(E${row}="A",E${row}="A-",E${row}="F",E${row}="W"),"No","")))`
          },
          {
            col: 11,
            formula: `=IF(OR(E${row}="D+",E${row}="D"),1,IF(OR(E${row}="C",E${row}="C-"),2,IF(E${row}="C+",3,IF(E${row}="B-",4,IF(E${row}="B",5,IF(E${row}="B+",6,IF(OR(E${row}="A-",E${row}="A"),7,IF(OR(E${row}="F",E${row}="W"),8,""))))))))`
          },
          {
            col: 14,
            formula: `=IF(AND(G${row}<>"Completed",E${row}<>"W",E${row}<>"F",E${row}<>""),D${row},0)`
          }
        ];
        
        formulas.forEach(function(f) {
          try {
            dataSheet.getRange(row, f.col).setFormula(f.formula);
          } catch(e) {
            // Skip if error
          }
        });
        
        // Update Is Latest
        if (courseCode && lastRow > 1) {
          try {
            var codes = dataSheet.getRange(2, 2, lastRow - 1, 1).getValues();
            var latestRow = 0;
            
            codes.forEach(function(item, index) {
              if (item[0] === courseCode) {
                var currentRow = index + 2;
                dataSheet.getRange(currentRow, 16).setValue("No");
                latestRow = currentRow;
              }
            });
            
            if (latestRow > 0) {
              dataSheet.getRange(latestRow, 16).setValue("Yes");
            }
          } catch(e) {
            // Skip if error
          }
        }
        
        // Update Semester GPA & Overall CGPA
        if (semester && lastRow > 1) {
          try {
            var semesterRows = dataSheet.getRange(2, 1, lastRow - 1, 1).getValues();
            
            semesterRows.forEach(function(item, index) {
              if (item[0] === semester) {
                dataSheet.getRange(index + 2, 17).setFormula(
                  '=IFERROR(SUMPRODUCT((A:A=' + semester + ')*(D:D)*(F:F)*(F:F>0))/SUMPRODUCT((A:A=' + semester + ')*(D:D)*(F:F>0)),0)'
                );
              }
            });
            
            dataSheet.getRange(row, 18).setFormula(
              '=IFERROR(SUMPRODUCT((H:H="Completed")*(D:D)*(F:F)*(F:F>0))/SUMPRODUCT((H:H="Completed")*(D:D)*(F:F>0)),0)'
            );
          } catch(e) {
            // Skip if error
          }
        }
        
        // Refresh Dashboard
        refreshAll();
        
        logActivity("User", "Edit", `Grade changed for ${courseCode}`);
      }
      
      // Course Status Changed
      if (col === 8) {
        refreshAll();
      }
    }
  } catch (error) {
    Logger.log('onEdit Error: ' + error);
  }
}

// ============================================================
// 🔧 UTILITY FUNCTIONS - FIXED
// ============================================================

function getSettingsValue(key) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const settingsSheet = ss.getSheetByName("⚙️ Settings");
    
    if (!settingsSheet) {
      return null;
    }
    
    const settingsData = settingsSheet.getDataRange().getValues();
    
    for (const row of settingsData) {
      if (row[0] === key) {
        return row[1];
      }
    }
    
    return null;
  } catch (error) {
    Logger.log('getSettingsValue Error: ' + error);
    return null;
  }
}

function getCurrentSemester() {
  const DEFAULT_SEMESTER = 262;
  
  try {
    const sheet = SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName("⚙️ Settings");
    
    if (!sheet) return DEFAULT_SEMESTER;
    
    const semester = sheet.getRange("B2").getValue();
    
    return semester || DEFAULT_SEMESTER;
    
  } catch (error) {
    Logger.log("getCurrentSemester Error: " + error);
    return DEFAULT_SEMESTER;
  }
}

// ============================================================
// 📊 CHART FUNCTIONS - NEW
// ============================================================

function createCharts() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var dashSheet = ss.getSheetByName('📈 Dashboard');
    var heatSheet = ss.getSheetByName('📊 Heatmap');
    
    if (!dashSheet || !heatSheet) return;
    
    // Get data range for charts
    var dataRange = dashSheet.getRange('E8:G20');
    var chart = dashSheet.newChart()
      .setChartType(SpreadsheetApp.ChartType.LINE)
      .addRange(dataRange)
      .setPosition(23, 5, 0, 0)
      .setOption('title', 'Semester GPA Trend')
      .setOption('curveType', 'function')
      .setOption('vAxis', {title: 'GPA'})
      .setOption('hAxis', {title: 'Semester'})
      .build();
    
    dashSheet.insertChart(chart);
    
    // Grade Distribution Pie Chart
    var analyticsSheet = ss.getSheetByName('📚 Course Analytics');
    if (analyticsSheet) {
      var gradeRange = analyticsSheet.getRange('A4:B15');
      var pieChart = analyticsSheet.newChart()
        .setChartType(SpreadsheetApp.ChartType.PIE)
        .addRange(gradeRange)
        .setPosition(4, 7, 0, 0)
        .setOption('title', 'Grade Distribution')
        .setOption('is3D', true)
        .build();
      
      analyticsSheet.insertChart(pieChart);
    }
    
    logActivity('System', 'Charts', 'Charts created successfully');
    
  } catch (error) {
    Logger.log('createCharts Error: ' + error);
  }
}